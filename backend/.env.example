# Bates Electric backend — environment variables.
# Placeholders only. Copy to backend/.env (gitignored) and fill in real values,
# or set them in the Render dashboard for production. Do NOT commit real secrets.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # server-only; bypasses RLS

# --- Stripe (Generator Care) ---
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                            # REQUIRED — webhook fails closed without it

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.xxx
GMAIL_USER=no-reply@bates-electric.com                     # From address for inspection emails
OFFICE_EMAIL=amyp@bates-electric.com

# --- Generator Care daily digest cron ---
CRON_SECRET=generate-a-long-random-string                 # cron-job.org sends this as the Bearer token
GENERATOR_DIGEST_FROM=no-reply@bates-electric.com
GENERATOR_DIGEST_TO=cjbates@bates-electric.com,generators@bates-electric.com
HEALTHCHECKS_URL=https://hc-ping.com/your-check-uuid       # optional dead-man's-switch

# --- Error reporting (optional) ---
SENTRY_DSN=
ALERT_EMAIL=cjbates@bates-electric.com

# --- Server ---
PORT=3000
